import std;

construct Player {
	var x;
	var y;
	
	func printDetails(p) {
		print("Player details:");
		print(p.x);
		print(p.y);
	};
};

invoke main {
	var maxNumPlayers = 40;
	Player one{.x = 1.0, .y=1.0};
	var players[] = std:array(dtype=Player, .size=400);
	players.insert(one);
	print("Player One Data Before Modification:");
	print(players.at(0).x);
	print(players.at(0).y);
	
	for (var i = 0 : range(maxNumPlayers), ++) {
		var new = Player{.x = 1.0, .y=1.0};
		players.insert(new);
	};
	
	print("Total Number of Players:");
	print(players.size());
	
	players.get(0).
}
