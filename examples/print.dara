construct Sample {
	int ffa;
};

construct Test {
	int a;
	float b;
	string c;
	color d;
	array s;
	Sample sample;
};

func main() -> noval {
	Test test = construct Test();
	
	std:print(std:typeof(test.a));
	std:print(std:typeof(test.b));
	std:print(std:typeof(test.c));
	std:print(std:typeof(test.d));
	std:print(std:typeof(test.s));
	std:print(std:typeof(test.sample));
	std:print(std:typeof(test.sample.ffa));	
};

std:print("10.01 larger than 10? ", 10.01 > 10);

main();
