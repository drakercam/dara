func modify(int& value) -> noval {
    value = 50;
};

func inspect(const int& value) -> noval {
    std:print(value);
};

int mutableNumber = 10;
const int immutableNumber = 20;

modify(mutableNumber);
std:print(mutableNumber);

modify(immutableNumber);
std:print(immutableNumber);

inspect(mutableNumber);
inspect(immutableNumber);
