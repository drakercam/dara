func getHealth() -> int {
    return 42;
};

print(getHealth());

func donothing() -> noval {
	return;
};

donothing();

construct Human {
	int x;
	int y;
	
	func printStats(Human h) -> noval {
		print(h.x);
		print(h.y);
	};
	
	func setPosition(Human& h, int newX, int newY) -> noval {
		h.x = newX;
		h.y = newY;
	};
};

Human human = construct Human(.x = 100, .y = 100);
Human.printStats(human);

Human.setPosition(human, 400, 200);

print(human.x);

human.x = 400;

print(human.x);
